{
  "name": "@kaushikgojo/release-lens",
  "version": "0.1.1",
  "description": "Compare exact npm tarball contents offline without installing packages.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lingikaushikreddy/release-lens.git",
    "directory": "packages/cli"
  },
  "homepage": "https://lingikaushikreddy.github.io/release-lens/",
  "bugs": {
    "url": "https://github.com/Lingikaushikreddy/release-lens/issues"
  },
  "keywords": [
    "npm",
    "tarball",
    "package-diff",
    "release-review",
    "cli",
    "offline"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "releaselens": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs",
    "evidence/RELEASE.md",
    "evidence/PUBLIC_RELEASE.md",
    "fixtures"
  ],
  "engines": {
    "node": ">=22"
  }
}
